{
  "name": "ay-portfolio",
  "version": "1.0.0",
  "description": "Monorepo: Express backend + React frontend",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:seed": "npm run db:seed --workspace=backend",
    "search:setup": "npm run search:setup --workspace=backend",
    "search:index": "npm run search:index --workspace=backend"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
